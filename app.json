{
  "expo": {
    "name": "ALTOKE",
    "slug": "ALTOKE",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon_1024x1024.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.ALTOKE"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive_foreground.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.ALTOKE"
    },
    "web": {
      "favicon": "./assets/altoke_icon.svg"
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-status-bar"
    ]
  }
}