{
  "expo": {
    "name": "ALTOKE",
    "slug": "ALTOKE",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/altoke_icon.svg",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/FIXY.svg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/FIXY.svg",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/altoke_icon.svg"
    },
    "plugins": ["expo-font", "expo-asset"]
  }
}
